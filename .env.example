# ---------------------------------------------------------------------------
# 24x7Chhutti - Environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in real values.
# Never commit a real `.env` file. Keep this file in sync with every new
# variable that the application reads.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Port the Express API listens on.
PORT=5000
# Comma-separated list of allowed browser origins for CORS (or a single origin).
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Client (Vite) ---------------------------------------------------------
# Base URL used by the Axios client for API requests.
# In development the Vite dev server proxies `/api` to the backend, so the
# default below works without further configuration.
VITE_API_URL=/api
# Backend target for the Vite dev proxy (only used during development).
# Override if your backend does not run on port 5000.
VITE_PROXY_TARGET=http://localhost:5000

# --- MongoDB ---------------------------------------------------------------
# Connection string for the MongoDB database.
# Local: mongodb://127.0.0.1:27017/24x7-website
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/24x7-website?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/24x7-website

# --- Authentication (JWT + HTTP-only cookie) -------------------------------
# Secret used to sign JWTs. MUST be a long, random, unguessable value in any
# non-local environment. Never commit a real value.
JWT_SECRET=dev-only-jwt-secret-change-me
# Token lifetime (https://github.com/vercel/ms format).
JWT_EXPIRES_IN=7d

# --- Cookies ---------------------------------------------------------------
# Cookie security is derived from NODE_ENV: secure=true and sameSite=none in
# production, secure=false and sameSite=lax in development.

# --- OTP (development/mock) ------------------------------------------------
# Master switch for the OTP service.
OTP_ENABLED=true
# How long an OTP remains valid, in seconds.
OTP_TTL_SECONDS=300
# In development (non-production) the generated OTP is echoed back in the API
# response for testing. There is no real SMS sending yet.

# --- AWS S3 media storage (AWS S3 bucket) --------------------------------
# Server-only — AWS credentials must NEVER be exposed to the frontend.
# Uploaded media (destination/trip/blog images, traveler media, logo) is
# stored in this S3 bucket. The bucket must allow public read for images to
# display, or be fronted by CloudFront/CDN.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Razorpay payments (planned, not yet implemented) ---------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Email / Nodemailer (planned, not yet implemented) --------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
